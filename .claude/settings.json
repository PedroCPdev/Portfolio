{
  "permissions": {
    "allow": [
      "Bash(node scripts/verify.mjs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.local)",
      "Read(./frontend/.env.*.local)",
      "Read(./frontend/.env.production)",
      "Read(./PortfolioApi/appsettings.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "pedro-harness": {
      "source": { "source": "github", "repo": "PedroCPdev/pedro-harness" }
    }
  },
  "enabledPlugins": {
    "pedro-harness@pedro-harness": true
  }
}
